# https://editorconfig.org — aligned with the WordPress coding standards.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{js,mjs,ts}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{po,pot}]
insert_final_newline = false
