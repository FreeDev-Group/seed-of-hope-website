<?xml version="1.0"?>
<ruleset name="Seed of Hope">
	<description>WordPress Coding Standards for the Seed of Hope theme, plugin and mu-plugins.</description>

	<file>wp-content/themes/seed-of-hope</file>
	<file>wp-content/plugins/seed-of-hope-core</file>
	<file>wp-content/mu-plugins</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<!-- Generated by `npm run i18n`. -->
	<exclude-pattern>*.l10n.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Hosting plans run PHP 8.1+. WordPress 7.0+ prints the skip link server-side. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="seed-of-hope"/>
				<element value="seed-of-hope-core"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="seed_of_hope"/>
				<element value="sohc"/>
				<element value="SeedOfHope"/>
			</property>
		</properties>
	</rule>
</ruleset>
