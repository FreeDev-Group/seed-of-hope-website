{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "46rem",
      "wideSize": "75rem"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "palette": [
        { "slug": "base", "name": "Warm white", "color": "#FFFDF8" },
        { "slug": "surface", "name": "Sand", "color": "#F6F0E4" },
        { "slug": "contrast", "name": "Deep green ink", "color": "#1E2A23" },
        { "slug": "contrast-muted", "name": "Muted ink", "color": "#4A5650" },
        { "slug": "primary", "name": "Leaf green", "color": "#2B6A4B" },
        { "slug": "primary-dark", "name": "Forest green", "color": "#1D4A35" },
        { "slug": "secondary", "name": "Terracotta", "color": "#9C4318" },
        { "slug": "accent", "name": "Sunrise gold", "color": "#E8B04A" },
        { "slug": "primary-soft", "name": "Soft sage", "color": "#E4EFE6" },
        { "slug": "accent-soft", "name": "Soft sunrise", "color": "#FBEFD6" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "dropCap": false,
      "fluid": {
        "minViewportWidth": "360px",
        "maxViewportWidth": "1200px"
      },
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Atkinson Hyperlegible",
          "fontFamily": "\"Atkinson Hyperlegible\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-latin-400-normal.woff2"]
            },
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-latin-400-italic.woff2"]
            },
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-latin-700-normal.woff2"]
            },
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "italic",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-latin-700-italic.woff2"]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Lexend",
          "fontFamily": "Lexend, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Lexend",
              "fontStyle": "normal",
              "fontWeight": "300 800",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/lexend/lexend-latin-wght-normal.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "1rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.125rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
        { "slug": "xxx-large", "name": "Gigantic", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "em", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "clamp(0.75rem, 1.5vw, 1rem)" },
        { "slug": "30", "name": "M", "size": "clamp(1rem, 2.5vw, 1.5rem)" },
        { "slug": "40", "name": "L", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
        { "slug": "50", "name": "XL", "size": "clamp(2rem, 6vw, 4rem)" },
        { "slug": "60", "name": "XXL", "size": "clamp(3rem, 8vw, 6rem)" }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "custom": {
      "radius": {
        "small": "0.375rem",
        "medium": "0.75rem",
        "large": "1.25rem"
      },
      "focus": {
        "width": "3px",
        "color": "var(--wp--preset--color--secondary)"
      }
    },
    "blocks": {
      "core/button": {
        "border": { "radius": true }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)",
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary-dark)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--secondary)" }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--custom--focus--color)",
            "offset": "3px",
            "style": "solid",
            "width": "var(--wp--custom--focus--width)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "var(--wp--custom--radius--small)" },
        "spacing": {
          "padding": { "top": "0.75em", "bottom": "0.75em", "left": "1.5em", "right": "1.5em" }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "700",
          "lineHeight": "1.3",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--custom--focus--color)",
            "offset": "3px",
            "style": "solid",
            "width": "var(--wp--custom--focus--width)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.25"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
      "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
      "caption": {
        "color": { "text": "var(--wp--preset--color--contrast-muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--primary-dark)" },
            "typography": { "textDecoration": "none" }
          }
        }
      },
      "core/site-tagline": {
        "color": { "text": "var(--wp--preset--color--contrast-muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "typography": { "textDecoration": "none" },
            ":hover": { "typography": { "textDecoration": "underline" } }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "typography": { "textDecoration": "underline" } }
          }
        }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--contrast-muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/post-terms": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/quote": {
        "border": {
          "left": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "6px" }
        },
        "spacing": {
          "padding": { "left": "var(--wp--preset--spacing--30)" }
        },
        "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontStyle": "italic" },
        "elements": {
          "cite": {
            "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontStyle": "normal" }
          }
        }
      },
      "core/details": {
        "border": {
          "bottom": { "color": "var(--wp--preset--color--surface)", "style": "solid", "width": "2px" }
        },
        "spacing": {
          "padding": { "top": "var(--wp--preset--spacing--20)", "bottom": "var(--wp--preset--spacing--20)" }
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      },
      "core/search": {
        "typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
      },
      "core/query-pagination": {
        "typography": { "fontWeight": "700" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page without title", "postTypes": ["page"] }
  ]
}
